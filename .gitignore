# ---------------------------------------------------------------
# 大体积产物：体积大，且可由脚本重新生成，不纳入版本库
# ---------------------------------------------------------------
# 打包快照（奥特曼发展史.zip 约 85 MB）
*.zip
# 无头浏览器验收截图（约 65 MB，跑 tools/qa.mjs 可重出）
**/qa/*.png
# QA 用的临时 Chrome 配置目录
.chrome-qa/

# 依赖与构建缓存
node_modules/
__pycache__/
*.pyc

# 编辑器 / 系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
